# ==============================================================================
# Sovereign ramO Engine Configuration (.env)
# ==============================================================================

# 1. Cloud Authentication & Tailscale Mesh (Required for Colab execution)
TAILSCALE_AUTHKEY=tskey-auth-kXXXXX-XXXXXXXXXXXXXXXXXXXX
HF_TOKEN=hf_yourHuggingFaceToken
GITHUB_TOKEN=ghp_yourGitHubToken

# 2. Server Network & Port Configuration
RAMO_PORT=50000
RAMO_HOST=0.0.0.0

# 3. Model & Engine Feature Toggles
RAMO_ENABLE_CLEANING=True
RAMO_ENABLE_VAD=True
RAMO_ENABLE_DIARIZATION=True
RAMO_ENABLE_TRANSLATION=True
RAMO_TTS_ENGINE=supertonic
